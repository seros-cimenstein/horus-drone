<Project Sdk="Microsoft.NET.Sdk">
  <!-- HorusGta's quad physics without GTA: answers ArduPilot's JSON SITL backend on udp 9002 over flat
       ground, with the same Core code the mod runs in game. Built and published by build.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>horus-gta-physics-sim</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Core/*.cs" />
  </ItemGroup>
</Project>
