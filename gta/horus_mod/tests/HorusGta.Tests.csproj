<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless checks of the engine-neutral core (no ScriptHookVDotNet); build.sh runs them with dotnet run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Core/*.cs" />
    <None Include="pose_vector.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../HorusGta.ini" Link="HorusGta.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
