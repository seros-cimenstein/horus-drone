<Project Sdk="Microsoft.NET.Sdk">

  <!-- ScriptHookVDotNet v3 script (.NET Framework 4.8). Build with gta/horus_mod/build.sh. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>HorusGta</AssemblyName>
    <RootNamespace>HorusGta</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Folder with ScriptHookVDotNet3.dll (compile reference only; never shipped). -->
    <ShvdnDir Condition="'$(ShvdnDir)' == ''">$(MSBuildThisFileDirectory)../.cache/shvdn</ShvdnDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(ShvdnDir)/ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <Target Name="CheckShvdn" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(ShvdnDir)/ScriptHookVDotNet3.dll')">
    <Error Text="ScriptHookVDotNet3.dll not found in '$(ShvdnDir)'; run gta/horus_mod/build.sh or pass -p:ShvdnDir=&lt;folder&gt;." />
  </Target>

</Project>
