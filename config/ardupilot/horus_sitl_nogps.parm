# ArduPilot Copter-4.7.1 GPS-denied SITL profile.
# SITL parameter groups are prefixed SIM_; GPSParms exposes ENABLE as SIM_GPS1_ENABLE.
SIM_GPS1_ENABLE 0

# Disable the GPS1 receiver backend as well as its simulated source.
GPS1_TYPE 0

# Skip the GPS-lock pre-arm check only; retain every other pre-arm check for indoor SITL.
ARMING_SKIPCHK 8
# Retain the existing MAVLink horizontal proximity-avoidance configuration.
PRX1_TYPE 2
AVOID_ENABLE 3
# Stop 1 m from proximity obstacles (default 2 m) so the executor's 1.2 m wall-centre geofence inset
# (0.1 m half wall + 1 m + 0.1 m slack) stays reachable instead of fighting avoidance at the edge.
AVOID_MARGIN 1.0

# Enable simulated flow generation and the SITL optical-flow backend.
SIM_FLOW_ENABLE 1
FLOW_TYPE 10

# Relative horizontal navigation from optical flow; altitude from barometer.
EK3_SRC1_POSXY 0
EK3_SRC1_VELXY 5
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 0

# Downward MAVLink DISTANCE_SENSOR (PITCH_270); 4.7.1 MIN/MAX units are metres.
RNGFND1_TYPE 10
RNGFND1_ORIENT 25
RNGFND1_MIN 0.05
RNGFND1_MAX 4.0

# iris_with_gimbal model maps output channels 9/10/11 to roll/pitch/yaw.
# ArduPilot mount servo functions are roll=8, tilt=7, pan=6.
MNT1_TYPE 1
MNT1_DEFLT_MODE 2
MNT1_PITCH_MIN -135
MNT1_PITCH_MAX 45
MNT1_YAW_MIN -160
MNT1_YAW_MAX 160
SERVO9_FUNCTION 8
SERVO10_FUNCTION 7
SERVO11_FUNCTION 6

# Optical-flow measurement noise (rad/s). SITL flow is otherwise ideal, which hides drift; ArduPilot's
# own optical-flow autotest uses 0.02. 0.05 represents a noisier indoor sensor for the S4 experiment.
SIM_FLOW_RND 0.05

# Indoor return altitude (m): RTL returns at max(2 m, current altitude) instead of the 15 m default,
# staying below the 2.5 m room walls.
RTL_ALT_M 2
