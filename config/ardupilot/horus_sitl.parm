# MAVLink-backed horizontal proximity sectors; the bridge sends DISTANCE_SENSOR.
PRX1_TYPE 2
AVOID_ENABLE 3
# Stop 1 m from proximity obstacles (default 2 m) so the executor's 1.2 m wall-centre geofence inset
# (0.1 m half wall + 1 m + 0.1 m slack) stays reachable instead of fighting avoidance at the edge.
AVOID_MARGIN 1.0

# Downward flow/altitude range input from DISTANCE_SENSOR orientation PITCH_270.
RNGFND1_TYPE 10
RNGFND1_ORIENT 25
RNGFND1_MIN_CM 5
RNGFND1_MAX_CM 400

# Gimbal (iris_with_gimbal): servo 9/10/11 drive roll/pitch/yaw. The model maps the pitch servo's
# 1100-1900 us range to +135..-45 deg, so MNT1_PITCH_MIN/MAX must be -135/45 (upstream
# gazebo-iris-gimbal.parm) for a -90 deg command to point the camera straight down.
MNT1_TYPE 1
MNT1_DEFLT_MODE 2
MNT1_PITCH_MIN -135
MNT1_PITCH_MAX 45
MNT1_YAW_MIN -160
MNT1_YAW_MAX 160
SERVO9_FUNCTION 8
SERVO10_FUNCTION 7
SERVO11_FUNCTION 6

# Indoor return altitude (m): RTL returns at max(2 m, current altitude) instead of the 15 m default,
# staying below the 2.5 m room walls.
RTL_ALT_M 2
