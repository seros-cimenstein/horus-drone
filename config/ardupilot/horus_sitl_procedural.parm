# Procedural GPS flight profile: a home-centred circular fence that covers the 1.2 km map
# corners and the maximum altitude. Generated worlds top out at 23 m forest canopy and
# 34 m urban building/roof-equipment height (see config/horus_procedural_*.yaml).
FENCE_ENABLE 1
FENCE_TYPE 3
FENCE_ACTION 1
# Map half extent 600 m -> corner distance 600*sqrt(2) = 848.5 m; 870 m leaves ~21 m of
# margin beyond the corners (plus FENCE_MARGIN 5 m) so the executor's +-585 m polygon, not
# the fence, is always the limit that stops a mission target.
FENCE_RADIUS 870
FENCE_MARGIN 5
FENCE_ALT_MAX 55

# Return above the tallest procedural forest canopy and urban rooftop hazards.
RTL_ALT_M 45

# Guided velocity targets are not clipped by the waypoint-speed parameters in Copter 4.7:
# mode_guided's VelAccel submode feeds the target straight into
# AC_PosControl::input_vel_accel_NE_m(..., limit_output=false), so WP_SPD caps only
# position/waypoint targets. The 8 m/s cruise therefore needs no speed parameter: it sits
# well inside the default ATC_ANGLE_MAX 30 deg (~5.7 m/s^2 of horizontal authority) and the
# default WP_ACC 2.5 m/s^2 ramp reaches it in ~3.2 s, while the executor still re-sends the
# velocity at 15 Hz, far inside GUID_TIMEOUT 3 s.

# Moderate wind from the west with variable gust/turbulence strength.
# Parameter names are from the Copter 4.7.1 SITL model.
SIM_WIND_DIR 270
SIM_WIND_SPD 4
SIM_WIND_TURB 2

# MAVLink-backed horizontal proximity sectors from the ToF payload (sim/models/horus_sensor_payload,
# bridged by scripts/tof_bridges.sh): ArduPilot's simple avoidance brakes before obstacles instead
# of flying through them.
PRX1_TYPE 2
AVOID_ENABLE 3
# Stop 1 m from proximity obstacles (default 2 m), matching the indoor profile so the executor's
# clearance margins (orbit 1.5 m, scan 2 m) stay reachable.
AVOID_MARGIN 1.0

# Downward ToF (payload range_down, 4 m range) as a short-range landing/altitude input.
RNGFND1_TYPE 10
RNGFND1_ORIENT 25
RNGFND1_MIN_CM 5
RNGFND1_MAX_CM 400

# Keep the ArduCopter SITL GPS model enabled with its default non-glitched settings.

# Outdoor mount starts neutral, pitched 45 degrees below level; missions may aim it over MAVLink.
MNT1_TYPE 1
MNT1_DEFLT_MODE 1
MNT1_PITCH_MIN -135
MNT1_PITCH_MAX 45
MNT1_YAW_MIN -160
MNT1_YAW_MAX 160
MNT1_NEUTRAL_X 0
MNT1_NEUTRAL_Y -45
MNT1_NEUTRAL_Z 0
MNT1_RETRACT_X 0
MNT1_RETRACT_Y -45
MNT1_RETRACT_Z 0
SERVO9_FUNCTION 8
SERVO10_FUNCTION 7
SERVO11_FUNCTION 6
