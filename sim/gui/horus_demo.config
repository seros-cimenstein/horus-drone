<?xml version="1.0"?>

<window>
  <width>1680</width>
  <height>1050</height>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>Indoor Scene</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <camera_pose>-10 0 8 0 0.5 0</camera_pose>
</plugin>

<!-- Without GzSceneManager the 3D view never receives the world's entities and stays black. -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="WorldControl" name="World Control">
  <gz-gui>
    <title>World Control</title>
    <property type="bool" key="resizable">false</property>
    <property type="int" key="width">220</property>
    <property type="int" key="height">110</property>
    <property type="int" key="x">24</property>
    <property type="int" key="y">24</property>
    <property type="int" key="z">1</property>
    <property type="string" key="state">floating</property>
    <property type="string" key="cardBackground">#EEEEEE</property>
  </gz-gui>
  <play_pause>true</play_pause>
  <step>true</step>
  <start_paused>false</start_paused>
  <service>/world/horus_indoor/control</service>
  <stats_topic>/world/horus_indoor/stats</stats_topic>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="width">5</property>
    <property type="double" key="height">5</property>
    <property type="string" key="state">floating</property>
    <property type="bool" key="showTitleBar">false</property>
  </gz-gui>
</plugin>

<plugin filename="HorusCommander" name="Horus Commander">
  <gz-gui>
    <title>Horus Commander</title>
    <property type="int" key="width">520</property>
    <property type="int" key="height">430</property>
    <property type="int" key="x">1120</property>
    <property type="int" key="y">40</property>
    <property type="int" key="z">1</property>
    <property type="string" key="state">floating</property>
    <property type="string" key="cardBackground">#F5F5F5</property>
  </gz-gui>
</plugin>

<plugin filename="ImageDisplay" name="Set-of-Marks Image">
  <gz-gui>
    <title>Set-of-Marks Output</title>
    <property type="int" key="width">520</property>
    <property type="int" key="height">355</property>
    <property type="int" key="x">1120</property>
    <property type="int" key="y">500</property>
    <property type="int" key="z">1</property>
    <property type="string" key="state">floating</property>
    <property type="string" key="cardBackground">#EEEEEE</property>
  </gz-gui>
  <topic_picker>false</topic_picker>
  <topic>/horus/som_image</topic>
</plugin>

<plugin filename="ImageDisplay" name="Raw Indoor Camera">
  <gz-gui>
    <title>Raw Indoor Camera</title>
    <property type="int" key="width">600</property>
    <property type="int" key="height">420</property>
    <property type="int" key="x">24</property>
    <property type="int" key="y">555</property>
    <property type="int" key="z">1</property>
    <property type="string" key="state">floating</property>
    <property type="string" key="cardBackground">#EEEEEE</property>
  </gz-gui>
  <topic_picker>false</topic_picker>
  <topic>/world/horus_indoor/model/horus_iris/model/iris_with_gimbal/model/gimbal/link/pitch_link/sensor/camera/image</topic>
</plugin>
