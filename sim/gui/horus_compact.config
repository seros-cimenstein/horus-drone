<?xml version="1.0"?>
<!-- Compact layout (HORUS_SIM_GUI_CONFIG=/horus/sim/gui/horus_compact.config): the 3D view fills
     the window and the panels are small untitled insets stacked down its left edge, so the scene
     stays visible on small screens and in recordings. start_sim.sh retargets /world/horus_indoor/. -->
<window>
  <width>1280</width>
  <height>1000</height>
  <menus>
    <drawer visible="false"/>
    <plugins visible="false"/>
  </menus>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <camera_pose>-10 0 8 0 0.5 0</camera_pose>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="width">5</property>
    <property type="double" key="height">5</property>
    <property type="string" key="state">floating</property>
    <property type="bool" key="showTitleBar">false</property>
  </gz-gui>
</plugin>

<plugin filename="WorldStats" name="World stats">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="int" key="width">170</property>
    <property type="int" key="height">60</property>
    <property type="int" key="x">8</property>
    <property type="int" key="y">8</property>
    <property type="int" key="z">1</property>
    <property type="string" key="state">floating</property>
    <property type="string" key="cardBackground">#CCEEEEEE</property>
  </gz-gui>
  <sim_time>true</sim_time>
  <real_time>false</real_time>
  <real_time_factor>true</real_time_factor>
  <iterations>false</iterations>
  <topic>/world/horus_indoor/stats</topic>
</plugin>

<!-- Every processed frame: YOLO boxes, tracker IDs, shirt colour. -->
<plugin filename="ImageDisplay" name="Live Perception">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="int" key="width">400</property>
    <property type="int" key="height">300</property>
    <property type="int" key="x">8</property>
    <property type="int" key="y">76</property>
    <property type="int" key="z">1</property>
    <property type="string" key="state">floating</property>
    <property type="string" key="cardBackground">#00000000</property>
  </gz-gui>
  <topic_picker>false</topic_picker>
  <topic>/horus/perception/live</topic>
</plugin>

<!-- Updates only when the model requests a frame: exactly what the LLM was shown. -->
<plugin filename="ImageDisplay" name="Set-of-Marks Image">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="int" key="width">400</property>
    <property type="int" key="height">300</property>
    <property type="int" key="x">8</property>
    <property type="int" key="y">384</property>
    <property type="int" key="z">1</property>
    <property type="string" key="state">floating</property>
    <property type="string" key="cardBackground">#00000000</property>
  </gz-gui>
  <topic_picker>false</topic_picker>
  <topic>/horus/som_image</topic>
</plugin>
