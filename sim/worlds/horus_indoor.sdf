          <material><ambient>0.32 0.18 0.16 1</ambient><diffuse>0.32 0.18 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cabinet_occluder">
      <static>true</static><pose>3.9 -2.7 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.65 1.4 1.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.65 1.4 1.7</size></box></geometry>
          <material><ambient>0.46 0.48 0.50 1</ambient><diffuse>0.46 0.48 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="corridor_screen">
      <!-- Across the corridor so a person crossing behind it is fully hidden from a follower to the south. -->
      <static>true</static><pose>0 5.3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.14 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.14 2.0</size></box></geometry>
          <material><ambient>0.63 0.66 0.69 1</ambient><diffuse>0.63 0.66 0.69 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include><uri>model://person_red</uri><name>person_red</name><pose>0.65 2.3 0 0 0 -1.5707963</pose></include>
    <include><uri>model://person_blue</uri><name>person_blue</name><pose>-1.8 3.0 0 0 0 -1.5707963</pose></include>
    <include><uri>model://person_green</uri><name>person_green</name><pose>-3.5 0.2 0 0 0 0</pose></include>
    <include><uri>model://person_laying</uri><name>person_laying</name><pose>2.4 -2.2 0 0 0 0.4</pose></include>

    <!-- The wrapper nests upstream iris_with_gimbal unchanged and fixes the local sensor payload inside model scope. -->
    <include><uri>model://horus_iris</uri><name>horus_iris</name><pose>0 0 0.195 0 0 1.5707963268</pose></include>
  </world>
</sdf>
