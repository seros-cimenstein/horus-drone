<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
    <model name="person_blue">
        <static>false</static>
        <link name="body">
            <inertial>
                <pose>0 -0.1 0.95 0 0 0</pose>
                <mass>80.0</mass>
                <inertia>
                    <ixx>24.88</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>25.73</iyy>
                    <iyz>0</iyz>
                    <izz>2.48</izz>
                </inertia>
            </inertial>
            <gravity>false</gravity>
            <kinematic>true</kinematic>
            <collision name="head">
                <pose>0 -0.1 1.62 0 0 0</pose>
                <geometry>
                    <sphere>
                        <radius>0.12</radius>
                    </sphere>
                </geometry>
            </collision>
            <collision name="bottom">
                <pose>0 -0.1 0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.5 0.35 0.02</size>
                    </box>
                </geometry>
            </collision>
            <!-- Primitive body collision: this kinematic person is moved through the corridor and its
                 route grazes the wall corner; a trimesh there made DART contacts collapse the real-time
                 factor to ~0.2, which starved SITL of heartbeats. -->
            <collision name="person">
                <pose>0 -0.1 0.78 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.22</radius>
                        <length>1.5</length>
                    </cylinder>
                </geometry>
            </collision>
            <!-- Own DAE copy so the mesh loads this model's blue tshirt02_texture.png. -->
            <visual name="visual">
                <pose>0 0 0.02 0.04 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://person_blue/meshes/standing.dae</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
    </model>
</sdf>