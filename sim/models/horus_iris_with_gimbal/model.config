<?xml version="1.0"?>

<model>
  <name>HORUS indoor Iris with gimbal</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Fadri Furrer</name>
    <email>fadri.furrer@mavt.ethz.ch</email>
  </author>
  <author>
    <name>Michael Burri</name>
  </author>
  <author>
    <name>Mina Kamel</name>
  </author>
  <author>
    <name>Janosch Nikolic</name>
  </author>
  <author>
    <name>Markus Achtelik</name>
  </author>

  <author>
    <name>Rhys Mainwaring</name>
  </author>

  <description>
    Local copy of ArduPilot Gazebo iris_with_gimbal with the upstream gimbal_small_3d
    camera; ArduPilot drives the rotors only, horus-gz-gimbal drives the gimbal.
  </description>
  <depend>
    <model>
      <uri>model://gimbal_small_3d</uri>
      <version>2.0</version>
    </model>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>2.0</version>
    </model>
  </depend>
 </model>
