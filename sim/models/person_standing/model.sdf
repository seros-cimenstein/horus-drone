                        <uri>model://person_blue/meshes/standing.dae</uri>
                        <submesh>
                            <name>v2_tshirt02</name>
                            <center>false</center>
                        </submesh>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                    <pbr>
                        <metal>
                            <metalness>0.0</metalness>
                            <albedo_map>model://person_standing/materials/textures/tshirt02_texture.png</albedo_map>
                        </metal>
                    </pbr>
                </material>
            </visual>
            <visual name="mesh_3">
                <pose>0 0 0.02 0.04 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://person_blue/meshes/standing.dae</uri>
                        <submesh>
                            <name>v2_mhair02</name>
                            <center>false</center>
                        </submesh>
                    </mesh>
                </geometry>
            </visual>
            <visual name="mesh_4">
                <pose>0 0 0.02 0.04 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://person_blue/meshes/standing.dae</uri>
                        <submesh>
                            <name>v2_Low-Poly</name>
