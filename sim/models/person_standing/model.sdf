<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
    <model name="person_standing">
        <static>true</static>
        <link name="body">
            <inertial>
                <pose>0 -0.1 0.95 0 0 0</pose>
                <mass>80.0</mass>
                <inertia>
                    <ixx>24.88</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>25.73</iyy>
                    <iyz>0</iyz>
                    <izz>2.48</izz>
                </inertia>
            </inertial>
            <collision name="bottom">
                <pose>0 -0.1 0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.5 0.35 0.02</size>
                    </box>
                </geometry>
            </collision>
            <collision name="person">
                <pose>0 0 0.02 0.04 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://person_blue/meshes/standing.dae</uri>
                    </mesh>
                </geometry>
            </collision>
            <!-- Shared standing mesh, one visual per submesh; only the T-shirt submesh overrides its material with this model's tshirt02_texture.png (the other submeshes keep the mesh's own textures). -->
            <visual name="mesh_0">
                <pose>0 0 0.02 0.04 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://person_blue/meshes/standing.dae</uri>
                        <submesh>
                            <name>v2_Body</name>
                            <center>false</center>
                        </submesh>
                    </mesh>
                </geometry>
            </visual>
            <visual name="mesh_1">
                <pose>0 0 0.02 0.04 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://person_blue/meshes/standing.dae</uri>
                        <submesh>
